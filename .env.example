POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=
DATABASE_URL=

# Public base URL used to build absolute links, including invitation links.
APP_BASE_URL=http://localhost:3000

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Invitation email delivery.
# Use "console" for local development until a production provider is configured.
# Future SMTP delivery should use "smtp" plus the SMTP_* variables below.
INVITATION_EMAIL_DELIVERY=console
INVITATION_EMAIL_FROM="ENADE Engenharia <noreply@enade.local>"
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
