POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# Required by Prisma and the application runtime.
DATABASE_URL=

# Public base URL used to build absolute links, including invitation links.
# Defaults to http://localhost:3000 when omitted.
APP_BASE_URL=http://localhost:3000

# Required by Better Auth.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Set to true only when local/test flows need Better Auth rate limiting disabled.
# Defaults to false when omitted.
BETTER_AUTH_RATE_LIMIT_DISABLED=false

# Invitation email delivery.
# Use "console" for local development until a production provider is configured.
# Future SMTP delivery should use "smtp" plus the SMTP_* variables below.
# Defaults to console when omitted.
INVITATION_EMAIL_DELIVERY=console

# Defaults to noreply@enade.local when omitted.
INVITATION_EMAIL_FROM="ENADE Engenharia <noreply@enade.local>"

# Optional console-delivery log target used by E2E helpers.
INVITATION_EMAIL_LOG_DIR=
INVITATION_EMAIL_LOG_FILE_NAME=

# Password reset email delivery.
# Use "console" for local development until a production provider is configured.
# Future SMTP delivery should use "smtp" plus the SMTP_* variables below.
# Defaults to console when omitted.
PASSWORD_RESET_EMAIL_DELIVERY=console

# Defaults to noreply@enade.local when omitted.
PASSWORD_RESET_EMAIL_FROM="ENADE Engenharia <noreply@enade.local>"

# Optional console-delivery log target used by E2E helpers.
PASSWORD_RESET_EMAIL_LOG_DIR=
PASSWORD_RESET_EMAIL_LOG_FILE_NAME=

# Optional until SMTP delivery is implemented.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Optional Supabase Storage settings for markdown question images.
# Keep these server-only; do not expose the secret key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_PUBLIC_URL=
