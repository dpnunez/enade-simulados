# Required by Prisma and the application runtime.
DATABASE_URL=

# Public canonical base URL used locally and in production.
# For Vercel Preview deployments, leave this unset and let VERCEL_URL provide
# the deployment-specific URL automatically.
# Server-side absolute links fall back to http://localhost:3000 when omitted
# outside Vercel.
NEXT_PUBLIC_URL=http://localhost:3000

# Required by Better Auth.
BETTER_AUTH_SECRET=

# Set to true only when local/test flows need Better Auth rate limiting disabled.
# Defaults to false when omitted.
BETTER_AUTH_RATE_LIMIT_DISABLED=false

# Invitation email delivery.
# Use "console" for local development and E2E.
# Use "smtp" in production after configuring Gmail SMTP with an app password.
# Defaults to console when omitted.
INVITATION_EMAIL_DELIVERY=console

# Defaults to noreply@enade.local when omitted. For Gmail SMTP, use the
# authenticated account or an alias authorized by that Gmail account.
INVITATION_EMAIL_FROM="ENADE Engenharia <sender@gmail.com>"

# Optional console-delivery log target used by E2E helpers.
INVITATION_EMAIL_LOG_DIR=
INVITATION_EMAIL_LOG_FILE_NAME=

# Password reset email delivery.
# Use "console" for local development and E2E.
# Use "smtp" in production after configuring Gmail SMTP with an app password.
PASSWORD_RESET_EMAIL_DELIVERY=console

PASSWORD_RESET_EMAIL_FROM="ENADE Engenharia <sender@gmail.com>"

# Optional console-delivery log target used by E2E helpers.
PASSWORD_RESET_EMAIL_LOG_DIR=
PASSWORD_RESET_EMAIL_LOG_FILE_NAME=

# Gmail SMTP settings for real transactional email delivery.
# Generate SMTP_PASSWORD as a Google app password after enabling
# 2-Step Verification; never commit or share the real value.
# Recommended Gmail SSL config:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sender@gmail.com
SMTP_PASSWORD=

# Alternative Gmail STARTTLS config:
# SMTP_PORT=587
# SMTP_SECURE=false

# Optional Supabase Storage settings for markdown question images.
# Keep these server-only; do not expose the secret key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_PUBLIC_URL=
